{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "ignition/**/*.ts"
  ],
  "exclude": [
    "frontend",
    "node_modules",
    "artifacts",
    "cache",
    "ignition/deployments"
  ]
}
