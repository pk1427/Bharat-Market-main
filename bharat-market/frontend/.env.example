# Frontend-safe env only. Never place PRIVATE_KEY in this file.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_key
NEXT_PUBLIC_RPC_PROXY_URL=/api/rpc
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0xa3ECcDE61C9cc8D575393801cAc1db8e8f8dD4c5
NEXT_PUBLIC_USDC_ADDRESS=0x79Ca0bb1adb03478C5C299fd858ab1Cf0d2264D9
NEXT_PUBLIC_COLLATERAL_LABEL=MockUSDC
NEXT_PUBLIC_COLLATERAL_SYMBOL=USDC
NEXT_PUBLIC_COLLATERAL_IS_MINTABLE=true
# Optional for staging with an external testnet token/faucet.
# Example official Circle Polygon Amoy USDC testnet address:
# NEXT_PUBLIC_USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
# NEXT_PUBLIC_COLLATERAL_LABEL=USDC
# NEXT_PUBLIC_COLLATERAL_IS_MINTABLE=false
# NEXT_PUBLIC_COLLATERAL_FAUCET_URL=https://faucet.circle.com/
NEXT_PUBLIC_MARKET_ORACLE_ADDRESS=0xB514C78225a4A98a77808A68371a6d631B0b46d7
NEXT_PUBLIC_CHAINLINK_ORACLE_ADDRESS=0xfaCaeedfEdA97a62A26959FB4b67c3aa2523352d
NEXT_PUBLIC_FEE_VAULT_ADDRESS=0x656FcF1a9579E2574f4CF721430DC3546d338576
NEXT_PUBLIC_DEFAULT_MARKET_ADDRESS=0xdDC4EbF6b46805EeC13F2d48Ffb9b767D729ff14
# Optional: narrow MarketCreated log scans for free-tier RPC providers.
# NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=12345678

# Indexed backend evolution (server-side only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bharatmarket
INDEXER_CONFIRMATIONS=5
INDEXER_BATCH_SIZE=2000
INDEXER_REORG_BUFFER=8
INDEXER_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_key
INDEXER_CRON_SECRET=replace_with_a_long_random_secret
INDEXER_SYNC_INTERVAL_MS=30000
RESOLUTION_CRON_SECRET=replace_with_a_long_random_secret
RESOLUTION_SYNC_INTERVAL_MS=30000
# Server-only hot wallet used only to submit Chainlink Functions resolution requests.
# Do not use a deployer wallet in production.
# RESOLUTION_WORKER_PRIVATE_KEY=0x...
# Local smoke-test signer used by `npm run smoke:cricket`.
# PRIVATE_KEY=0x...
# Provider secret for cricket markets.
# CRICAPI_KEY=your_cricapi_key
# Chainlink DON-hosted secrets reference used by the deployed ChainlinkFunctionsOracle.
# These are deploy-time values for the contract, not frontend-public env vars.
# CHAINLINK_SECRETS_SLOT_ID=0
# CHAINLINK_SECRETS_VERSION=1
# Public relay fallback used when Chainlink Functions cannot reach CricAPI directly.
# CRICKET_RELAY_URL=https://your-domain.example/api/oracles/cricket/match
# Cricket smoke-test inputs.
# CRICKET_MATCH_ID=finished_match_id
# CRICKET_TEAM_A=MI
# CRICKET_TEAM_B=KKR
# CRICKET_SELECTED_TEAM=MI
# Keep false until ChainlinkFunctionsOracle is redeployed with bm:v1 metadata parsing.
NEXT_PUBLIC_STRUCTURED_ORACLES_ENABLED=false
