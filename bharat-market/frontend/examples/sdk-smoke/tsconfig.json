{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "viem": ["../../node_modules/viem"],
      "viem/*": ["../../node_modules/viem/*"]
    },
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "../../..",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
