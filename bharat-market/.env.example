COLLATERAL_TOKEN_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
COLLATERAL_TOKEN_LABEL=USDC

# Frontend env generation helpers
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
